# Check everything out with CRLF so .bat files behave and the PowerShell
# scripts stay valid on Windows.
* text=auto eol=crlf

# The macOS side needs LF: a shell script with CRLF fails on its shebang.
*.sh    text eol=lf
*.m     text eol=lf
*.plist text eol=lf

*.png binary
*.ico binary
*.icns binary
