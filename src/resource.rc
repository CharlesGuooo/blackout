#include <winver.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "..\\assets\\blackout.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    BLACKOUT_VER_MAJOR, BLACKOUT_VER_MINOR, BLACKOUT_VER_PATCH, 0
  PRODUCTVERSION BLACKOUT_VER_MAJOR, BLACKOUT_VER_MINOR, BLACKOUT_VER_PATCH, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Charles Guo"
            VALUE "FileDescription",  "Blackout - fullscreen to-do reminder"
            VALUE "FileVersion",      BLACKOUT_VERSION_STR
            VALUE "InternalName",     "Blackout"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "Blackout.exe"
            VALUE "ProductName",      "Blackout"
            VALUE "ProductVersion",   BLACKOUT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
